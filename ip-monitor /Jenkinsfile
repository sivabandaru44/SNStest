pipeline {
    agent any   // ✅ THIS FIXES YOUR ERROR

    stages {

        stage('Run Test Command') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'aws-creds'
                ]]) {
                    sh 'echo Pipeline is working'
                }
            }
        }

    }
}
